{
  "name": "de-crapify",
  "version": "0.1.0",
  "description": "Clean up the messy patterns AI coding assistants leave in JS/TS code, locally and safely.",
  "homepage": "https://github.com/chionye/de-crapify#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chionye/de-crapify.git"
  },
  "bugs": {
    "url": "https://github.com/chionye/de-crapify/issues"
  },
  "type": "module",
  "bin": {
    "de-crapify": "src/index.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "cli",
    "cleanup",
    "ai",
    "ollama",
    "lint",
    "javascript",
    "typescript",
    "react",
    "refactor",
    "unused-imports",
    "console-log",
    "codemod",
    "llm",
    "local-ai",
    "react-native"
  ],
  "author": "michael valentine",
  "license": "ISC",
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@babel/traverse": "^7.29.8",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "diff": "^9.0.0",
    "ignore": "^7.0.12",
    "magic-string": "^1.4.3"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "typescript-6": "npm:typescript@^6.0.3"
  },
  "optionalDependencies": {
    "node-llama-cpp": "^3.22.1"
  },
  "config": {
    "nodeLlamaCppPostinstall": "ignoreFailedBuild"
  }
}

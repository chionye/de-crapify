  "license": "ISC",
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@babel/traverse": "^7.29.8",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "diff": "^9.0.0",
    "ignore": "^7.0.12",
    "magic-string": "^1.4.3"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "typescript-6": "npm:typescript@^6.0.3"
  },
  "optionalDependencies": {
